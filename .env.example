# Copy to .env (docker compose reads it) and fill in. .env is ignored by git.
POSTGRES_PASSWORD=
# Set to require X-API-Key on every write. Recommended for any shared deployment.
RASAD_API_KEY=
# live | replay | replay:YYYY-MM-DD  (empty = synthetic weather)
RASAD_REAL_DATA=
TZ=Asia/Kolkata
# For the optional Qwen3-8B service (docker compose --profile llm up -d)
HF_TOKEN=
